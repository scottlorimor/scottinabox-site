#!/bin/bash
# Block direct pushes to main. Push to a branch and open a PR instead.
# Installed via: git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Blocked: direct pushes to main are not allowed." >&2
    echo "Push to a feature branch and open a pull request instead." >&2
    exit 1
  fi
done

exit 0
